# This file is the tracked example environment file for this stack. Sensitive values are intentionally blank.
#GLUETUN_HTTPPROXY_PASSWORD=
#GLUETUN_HTTPPROXY_USER=
#GLUETUN_OPENVPN_PASSWORD=
#GLUETUN_OPENVPN_USER=
#GLUETUN_PORT_FORWARD_PASS=
#GLUETUN_PORT_FORWARD_PROVIDER=
#GLUETUN_PORT_FORWARD_USER=
#GLUETUN_SS_PASSWORD=
#GLUETUN_VPN_ENDPOINT_IP=
#GLUETUN_VPN_ENDPOINT_PORT=
#GLUETUN_WG_ADDRESSES=
#GLUETUN_WG_KEEPALIVE=
#GLUETUN_WG_PRESHARED_KEY=
GLUETUN_WG_PRIVATE_KEY=""
#GLUETUN_WG_PUBLIC_KEY=
# Apprise endpoint for the upPollo staging script (#1121). SABnzbd runs inside gluetun's
# namespace, whose resolver is the tunnel's, so Docker hostnames do not resolve - the apprise
# container IP and its internal port, pinned in stacks/apprise/compose.yaml. The same
# `qbittorrent` notify key the runner uses, so every upPollo outcome lands in one channel.
# Leave empty to disable notifications.
APPRISE_ENDPOINT="http://172.18.0.7:8000/notify/qbittorrent"
SERVICE=sabnzbd
SPECIAL_HEADER_NAME=X-Homelab-Access-Bypass
SPECIAL_HEADER_SECRET=""
TRAEFIK_EXTERNAL_URL=sabnzbd.example.com
TRAEFIK_INTERNAL_URL=http://gluetun:8080
UNRAID_WEBGUI_URL=http://192.0.2.99:8082
