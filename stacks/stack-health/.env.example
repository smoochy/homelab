# This file is the tracked example environment file for this stack. Sensitive values are intentionally blank.
SERVICE=stack-health
KOMODO_ADDRESS=http://192.0.2.99:9120
KOMODO_API_KEY=""
KOMODO_API_SECRET=""
KOMODO_HOST=https://komodo.example.com
APPRISE_ENDPOINT=http://172.18.0.7:8000/notify/komodo
# Push token only, not a URL: it feeds both the AutoKuma label and the push URL in compose.yaml. Monitor settings in Uptime Kuma: 60 / 2 / 60 (interval / retries / retry interval, seconds), matching the poller's 60s round.
KUMA_PUSH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional. Left commented out because the encryption helper rejects an empty value.
# STACK_HEALTH_EXCLUDE_STACKS=
