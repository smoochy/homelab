# This file is the tracked example environment file for this stack. Sensitive values are intentionally blank.
SERVICE=proton-renewer
PROTON_USERNAME=""
PROTON_PASSWORD=""
APPRISE_ENDPOINT=http://172.18.0.7:8000/notify/proton-renewer
# Optional, normally empty. A solved CAPTCHA token (code 9001), single use. Left commented out because the encryption helper rejects an empty value.
# PROTONVPN_HV_TOKEN=
# Optional. Comma separated serials the renewer may revoke on error 2028 (account cap). Empty means alert only. Left commented out for the same reason.
# REVOKE_ALLOWED_SERIALS=
