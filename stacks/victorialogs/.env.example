# This file is the tracked example environment file for this stack. Sensitive values are intentionally blank.
SERVICE=victorialogs
TRAEFIK_EXTERNAL_URL=logs.example.com
TRAEFIK_INTERNAL_URL=http://victorialogs:9428
UNRAID_WEBGUI_URL=https://logs.example.com
# Alertmanager's own internal-only route. The UI is here for silences; the
# notification path itself needs no route.
ALERTMANAGER_EXTERNAL_URL=alerts.example.com
ALERTMANAGER_INTERNAL_URL=http://alertmanager:9093
# Discord webhook of the dedicated log-alert channel. Raw webhook URL, not a bot token.
DISCORD_LOG_ALERT_WEBHOOK=""
