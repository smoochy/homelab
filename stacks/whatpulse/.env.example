# This file is the tracked example environment file for this stack. Sensitive values are intentionally blank.
SERVICE=whatpulse
# The hostname of the Traefik router. Not `TRAEFIK_EXTERNAL_URL`, which every
# other stack uses for this, because this one has no external router at all:
# the name would claim a reachability the stack deliberately does not have.
TRAEFIK_INTERNAL_HOST=wp.example.com
# The router's upstream. A host address rather than the usual
# `http://<service>:<port>`, because the container shares the host's network
# namespace and has no name on smoonet to resolve.
TRAEFIK_INTERNAL_URL=http://192.0.2.99:6799
UNRAID_WEBGUI_URL=http://192.0.2.99:6799
# Password for the web VNC front end. The container refuses to start without it,
# because that front end is remote control of the logged-in client and, in the
# host network namespace, is reachable from the LAN.
WP_VNC_PASSWORD=""
