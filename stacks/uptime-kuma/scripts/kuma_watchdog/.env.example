# Copy to .env next to kuma_watchdog.sh and fill in. The .env is never committed.

KUMA_CONTAINER_NAME="uptime-kuma"
KUMA_BASE_URL="http://127.0.0.1:3001"

# Either an auth token, or username and password. The token wins when both are set.
KUMA_AUTH_TOKEN=""
KUMA_USERNAME=""
KUMA_PASSWORD=""

KUMA_SOCKET_TIMEOUT_MS="20000"

# Discord webhook the findings are posted to. This is a direct post, never routed through Kuma.
DISCORD_WEBHOOK_URL=""

# Report a maintenance window that has been suppressing alerts for longer than this.
MAINTENANCE_MAX_HOURS="6"

# Repeat a finding this often while the condition still holds.
RESEND_HOURS="24"

# Set to 1 to also report paused monitors that have no notification attached.
INCLUDE_PAUSED_MONITORS="0"
